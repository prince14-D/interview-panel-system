# Ministry of Youth and Sports — Interview Panel Management & Scoring System
# Copy this file to .env and update with your environment credentials.

APP_NAME="MYS Interview Panel & Scoring System"
APP_ORG="Ministry of Youth and Sports, Republic of Liberia"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Interview-Panel/public
APP_TIMEZONE=Africa/Monrovia
APP_SECRET=change-this-to-a-64-character-random-secret-key-in-production

# Database Configuration (MySQL 8+ / MariaDB 10.6+)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mys_interview_panel
DB_USERNAME=root
DB_PASSWORD=

# Virtual Interview WebRTC Provider Configuration
# Supported providers: jitsi (default, ready out-of-the-box) or livekit
VIDEO_DEFAULT_PROVIDER=jitsi

# Jitsi Meet Configuration (public meet.jit.si or self-hosted Jitsi domain)
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=

# LiveKit Configuration (for LiveKit Cloud or self-hosted LiveKit Server)
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
